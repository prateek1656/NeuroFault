{
  "name": "resnet9_e2_bn_recal_only_seed106",
  "seed": 106,
  "simulator": "crosssim",
  "dataset": "cifar10",
  "num_classes": 10,
  "model_arch": "resnet9",
  "train_samples": 50000,
  "test_samples": 5000,
  "batch_size": 128,
  "learning_rate": 0.05,
  "weight_decay": 0.0001,
  "lr_cosine_schedule": false,
  "optimizer": "sgd",
  "momentum": 0.9,
  "lr_one_cycle": false,
  "label_smoothing": 0.1,
  "grad_clip_norm": 1.0,
  "float_pretrain_epochs": 10,
  "finetune_learning_rate": 0.0,
  "epochs": 14,
  "num_batches": 390,
  "eval_interval": 100,
  "device": {
    "name": "vteam",
    "r_on": 100.0,
    "r_off": 10000.0,
    "time_series_resolution": 1e-10,
    "extra_params": {}
  },
  "crossbar": {
    "scheme": "DoubleColumn",
    "tile_shape": null,
    "patch_layer_types": [
      "Linear",
      "Conv2d"
    ],
    "max_input_voltage": 0.3,
    "adc_resolution": 8,
    "dac_resolution": 8,
    "redundancy_factor": 0.15,
    "redundancy_scheme": "idealized_per_cell",
    "redundancy_condemn_threshold": 0.5,
    "use_gpu": true,
    "circuit_topology": null,
    "devices_per_synapse": 1,
    "calibrate_adc": true,
    "adc_calibration_images": 320,
    "calibrate_dac": true
  },
  "fault": {
    "density": 0.1,
    "distribution": "random",
    "injection_interval": 5200,
    "failure_model": "density",
    "weibull_shape": 2.0,
    "weibull_scale": null,
    "exponential_rate": null,
    "arrhenius_activation_energy_ev": null,
    "temperature_kelvin": 300.0,
    "reference_temperature_kelvin": 300.0,
    "drift_magnitude": 0.05,
    "drift_direction": "toward_hrs",
    "stuck_lrs_fraction": 0.5,
    "wave_densities": [
      0.1,
      0.1,
      0.1
    ]
  },
  "secondary_fault": null,
  "mitigation": {
    "enable_soft_mitigation": false,
    "enable_remapping": true,
    "enable_layer_reset": false,
    "enable_predictive": false,
    "force_remapping": false,
    "health_threshold": 75.0,
    "health_check_interval": 10,
    "detection_method": "full_diff",
    "checksum_z_threshold": 3.0,
    "layer_reset_cooldown_checks": 10
  },
  "retraining": {
    "enable_fault_aware": false,
    "policy": "bn_recal_only",
    "burst_lr": 0.001,
    "burst_batches": 200,
    "burst_t_max": 1000,
    "patience_window": 3,
    "patience_eval_every": 25,
    "patience_min_gain": 0.5,
    "canary_gate_delta": 1.0,
    "canary_gate_reference": "previous",
    "canary_size": 1024,
    "bn_recal_batches": 20,
    "reference_mode": "frozen",
    "freeze_stuck_weights": null,
    "remap_order": "random",
    "remap_pacing": "greedy",
    "expected_waves": null,
    "priors_path": null,
    "burst_mode": "adaptive",
    "fisher_ema_decay": 0.99,
    "gate_noise_k": null,
    "noise_aware_plateau": false,
    "anneal_on_stop": false,
    "restore_best": false,
    "anneal_steps": 50,
    "liu_retrain_at": "last",
    "liu_remap_after_retrain": true
  },
  "output_dir": "results",
  "save_checkpoint": false,
  "regime": "deployment",
  "pre_deploy_checkpoint": "results/resnet9_predeploy_seed106/pre_deploy.pt",
  "save_pre_deploy_checkpoint": false
}